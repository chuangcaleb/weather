{
  "name": "weather",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.5"
    }
  },
  "scripts": {
    "dev": "vite",
