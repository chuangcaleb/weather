{
  "compilerOptions": {
    "target": "ES2022",
    "composite": true,
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
